<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Directors</title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <div class="container">
      <%- include('../partials/nav') %>

      <h1>Directors</h1>

      <a href="/directors/new" class="add-link">+ Add a director</a>

      <% if (directors.length === 0) { %>
      <div class="empty-message">No directors found.</div>
      <% } else { %>
      <ul class="director-list">
        <% directors.forEach(director => { %>
        <li class="director-item">
          <h2><a href="/directors/<%= director.id %>"><%= director.name %></a></h2>
          <% if (director.bio) { %>
          <div class="director-bio"><%= director.bio %></div>
          <% } %>
        </li>
        <% }); %>
      </ul>
      <% } %>
    </div>
  </body>
</html>
