<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= director.name %></title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <div class="container">
      <%- include('../partials/nav') %>

      <a href="/directors" class="back-link">← Back to Directors</a>

      <h1><%= director.name %></h1>

      <a href="/directors/<%= director.id %>/edit">Edit Director</a>

      <form
        action="/directors/<%= director.id %>/delete"
        method="POST"
        onsubmit="return confirm('Delete this director? Films will be kept but unlinked from them.');"
      >
        <%- include('../partials/adminPassword') %>
        <button type="submit">Delete Director</button>
      </form>

      <% if (director.bio) { %>
      <div class="section">
        <h2>Biography</h2>
        <p><%= director.bio %></p>
      </div>
      <% } %>

      <div class="section">
        <h2>Films</h2>
        <% if (films.length === 0) { %>
        <div class="empty-message">No films found.</div>
        <% } else { %>
        <ul>
          <% films.forEach(film => { %>
          <li class="film-item">
            <h2><a href="/films/<%= film.id %>"><%= film.title %></a></h2>
            <div class="film-meta">
              <strong>Release Year:</strong> <%= film.release_year %> | <strong>Runtime:</strong> <%= film.runtime_minutes %> minutes
            </div>
            <% if (film.genres && film.genres.length > 0) { %>
            <div class="tags">
              <strong>Genres:</strong>
              <% film.genres.forEach(genre => { %>
              <a href="/genres/<%= genre.id %>" class="tag"><%= genre.name %></a>
              <% }); %>
            </div>
            <% } %>
          </li>
          <% }); %>
        </ul>
        <% } %>
      </div>
    </div>
  </body>
</html>
