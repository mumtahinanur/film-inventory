<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= locals.heading ?? 'Add a Genre' %></title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <div class="container">
      <%- include('../partials/nav') %>

      <a href="<%= locals.backHref ?? '/genres' %>" class="back-link"><%= locals.backLabel ?? '← Back to Genres' %></a>

      <h1><%= locals.heading ?? 'Add a Genre' %></h1>

      <% if (errors.length > 0) { %>
      <ul class="errors">
        <% errors.forEach(error => { %>
        <li><%= error %></li>
        <% }); %>
      </ul>
      <% } %>

      <form action="<%= locals.action ?? '/genres' %>" method="POST">
        <div class="field">
          <label for="name">Name</label>
          <input type="text" id="name" name="name" maxlength="100" required value="<%= values.name ?? '' %>" />
        </div>

        <div class="field">
          <label for="description">Description</label>
          <textarea id="description" name="description" rows="4"><%= values.description ?? '' %></textarea>
        </div>

        <% if (locals.requirePassword) { %>
        <div class="field">
          <label for="admin_password">Admin password</label>
          <input type="password" id="admin_password" name="admin_password" required autocomplete="off" />
        </div>
        <% } %>

        <button type="submit"><%= locals.submitLabel ?? 'Add Genre' %></button>
      </form>
    </div>
  </body>
</html>
