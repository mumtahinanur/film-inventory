<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= genre.name %></title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <div class="container">
      <%- include('../partials/nav') %>

      <a href="/genres" class="back-link">← Back to Genres</a>

      <h1><%= genre.name %></h1>

      <a href="/genres/<%= genre.id %>/edit">Edit Genre</a>

      <form
        action="/genres/<%= genre.id %>/delete"
        method="POST"
        onsubmit="return confirm('Delete this genre? Films will be kept but unlinked from it.');"
      >
        <div class="field">
          <label for="admin_password">Admin password</label>
          <input type="password" id="admin_password" name="admin_password" required autocomplete="off" />
        </div>
        <button type="submit">Delete Genre</button>
      </form>

      <% if (genre.description) { %>
      <div class="section">
        <h2>Description</h2>
        <p><%= genre.description %></p>
      </div>
      <% } %>

      <div class="section">
        <h2>Films</h2>
        <% if (films.length === 0) { %>
        <div class="empty-message">No films found.</div>
        <% } else { %>
        <ul class="film-list">
          <% films.forEach(film => { %>
          <li class="film-item">
            <h2><a href="/films/<%= film.id %>"><%= film.title %></a></h2>
            <div class="film-meta">
              <strong>Release Year:</strong> <%= film.release_year %> | <strong>Runtime:</strong> <%= film.runtime_minutes %> minutes
            </div>
            <% if (film.directors && film.directors.length > 0) { %>
            <div class="tags">
              <strong>Directors:</strong>
              <% film.directors.forEach(director => { %>
              <a href="/directors/<%= director.id %>" class="tag"><%= director.name %></a>
              <% }); %>
            </div>
            <% } %>
          </li>
          <% }); %>
        </ul>
        <% } %>
      </div>
    </div>
  </body>
</html>
