<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= genre.name %></title>
  </head>
  <body>
    <div class="container">
      <nav>
        <a href="/">Home</a>
        <a href="/films">Films</a>
        <a href="/directors">Directors</a>
        <a href="/genres">Genres</a>
      </nav>

      <a href="/genres" class="back-link">← Back to Genres</a>

      <h1><%= genre.name %></h1>

      <a href="/genres/<%= genre.id %>/edit">Edit Genre</a>

      <% if (genre.description) { %>
      <div class="section">
        <h2>Description</h2>
        <p><%= genre.description %></p>
      </div>
      <% } %>

      <div class="section">
        <h2>Films</h2>
        <% if (films.length === 0) { %>
        <div class="empty-message">No films found.</div>
        <% } else { %>
        <ul class="film-list">
          <% films.forEach(film => { %>
          <li class="film-item">
            <h2><a href="/films/<%= film.id %>"><%= film.title %></a></h2>
            <div class="film-meta">
              <strong>Release Year:</strong> <%= film.release_year %> | <strong>Runtime:</strong> <%= film.runtime_minutes %> minutes
            </div>
            <% if (film.directors && film.directors.length > 0) { %>
            <div class="tags">
              <strong>Directors:</strong>
              <% film.directors.forEach(director => { %>
              <a href="/directors/<%= director.id %>" class="tag"><%= director.name %></a>
              <% }); %>
            </div>
            <% } %>
          </li>
          <% }); %>
        </ul>
        <% } %>
      </div>
    </div>
  </body>
</html>
