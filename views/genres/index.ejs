<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Genres</title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <div class="container">
      <%- include('../partials/nav') %>

      <h1>Genres</h1>

      <a href="/genres/new" class="add-link">+ Add a genre</a>

      <% if (genres.length === 0) { %>
      <div class="empty-message">No genres found.</div>
      <% } else { %>
      <ul>
        <% genres.forEach(genre => { %>
        <li class="genre-item">
          <h2><a href="/genres/<%= genre.id %>"><%= genre.name %></a></h2>
          <% if (genre.description) { %>
          <div><%= genre.description %></div>
          <% } %>
        </li>
        <% }); %>
      </ul>
      <% } %>
    </div>
  </body>
</html>
