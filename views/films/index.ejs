<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Films</title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <div class="container">
      <nav>
        <a href="/">Home</a>
        <a href="/directors">Directors</a>
        <a href="/genres">Genres</a>
      </nav>

      <h1>Films</h1>

      <a href="/films/new" class="add-link">+ Add a film</a>

      <% if (films.length === 0) { %>
      <div class="empty-message">No films found.</div>
      <% } else { %>
      <ul class="film-list">
        <% films.forEach(film => { %>
        <li class="film-item">
          <h2><a href="/films/<%= film.id %>"><%= film.title %></a></h2>
          <div class="film-meta">
            <strong>Release Year:</strong> <%= film.release_year %> | <strong>Runtime:</strong> <%= film.runtime_minutes %> minutes
          </div>
          <% if (film.description) { %>
          <div class="film-description"><%= film.description %></div>
          <% } %>
          <% if (film.directors && film.directors.length > 0) { %>
          <div class="tags">
            <strong>Directors:</strong>
            <% film.directors.forEach(director => { %>
            <a href="/directors/<%= director.id %>" class="tag"><%= director.name %></a>
            <% }); %>
          </div>
          <% } %>
          <% if (film.genres && film.genres.length > 0) { %>
          <div class="tags">
            <strong>Genres:</strong>
            <% film.genres.forEach(genre => { %>
            <a href="/genres/<%= genre.id %>" class="tag"><%= genre.name %></a>
            <% }); %>
          </div>
          <% } %>
        </li>
        <% }); %>
      </ul>
      <% } %>
    </div>
  </body>
</html>
